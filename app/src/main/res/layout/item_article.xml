<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/articleCard"
    android:layout_width="349dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginBottom="16dp"
    card_view:cardCornerRadius="15dp"
    card_view:cardElevation="4dp"
    card_view:cardBackgroundColor="#D9D9D9">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/articleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titolo Articolo"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#000000"
            android:paddingTop="8dp" />

        <ImageView
            android:id="@+id/articleImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@id/articleTitle"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/descriptionOverlay"
            android:layout_width="159dp"
            android:layout_height="110dp"
            android:layout_alignEnd="@id/articleImage"
            android:layout_alignTop="@id/articleImage"
            android:layout_margin="8dp"
            android:background="#80CCEFF0"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/articleDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descrizione articolo"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/articlePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/articleImage"
            android:layout_marginTop="8dp"
            android:text="Telefono: 1234567890"
            android:textColor="#000000"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/articleLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/articlePhone"
            android:layout_marginTop="4dp"
            android:text="Luogo: Milano"
            android:textColor="#000000"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
